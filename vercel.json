{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/login/?", "dest": "/public/login.html" },
    { "src": "/dashboard/?", "dest": "/public/dashboard.html" },
    { "src": "/documents/?", "dest": "/public/documents.html" },
    { "src": "/payments/?", "dest": "/public/payments.html" },
    { "src": "/inspections/?", "dest": "/public/inspections.html" },
    { "src": "/reports/?", "dest": "/public/reports.html" },
    { "src": "/info/?", "dest": "/public/info.html" },
    { "src": "/admin/?", "dest": "/public/admin.html" },
    { "src": "/robots\\.txt", "dest": "/public/robots.txt" },
    { "src": "/sitemap\\.xml", "dest": "/public/sitemap.xml" },
    { "src": "/manifest\\.json", "dest": "/public/manifest.json" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
