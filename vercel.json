{
  "version": 2,
  "headers": [
    { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }] },
    { "source": "/humans.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }] },
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/login", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/dashboard", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/info", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/login/?", "dest": "/public/login.html" },
    { "src": "/dashboard/?", "dest": "/public/dashboard.html" },
    { "src": "/documents/?", "dest": "/public/documents.html" },
    { "src": "/payments/?", "dest": "/public/payments.html" },
    { "src": "/inspections/?", "dest": "/public/inspections.html" },
    { "src": "/reports/?", "dest": "/public/reports.html" },
    { "src": "/info/?", "dest": "/public/info.html" },
    { "src": "/admin/?", "dest": "/public/admin.html" },
    { "src": "/robots\\.txt", "dest": "/public/robots.txt" },
    { "src": "/sitemap\\.xml", "dest": "/public/sitemap.xml" },
    { "src": "/humans\\.txt", "dest": "/public/humans.txt" },
    { "src": "/manifest\\.json", "dest": "/public/manifest.json" },
    { "src": "/favicon\\.ico", "dest": "/public/favicon.ico" },
    { "src": "/apple-touch-icon\\.png", "dest": "/public/apple-touch-icon.png" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
